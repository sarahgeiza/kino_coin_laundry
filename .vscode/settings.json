{
    "editor.wordWrap": "on",
    "editor.formatOnSave": true,
    "html.format.wrapLineLength": 120,
    "javascript.format.semicolons": "insert",
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true
    },
    "javascript.validate.enable": true,
    "typescript.validate.enable": true
}