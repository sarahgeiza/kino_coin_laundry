    {
      "name": "Login Kasir",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/api/index.php?module=auth&action=login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"kasir\",\n  \"password\": \"{{kasir_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json.csrf_token) pm.collectionVariables.set(\"csrf_token\", json.csrf_token);",
              "}"
            ]
          }
        }
      ]
    },
